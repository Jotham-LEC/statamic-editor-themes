{
    "name": "jotham-lec/statamic-editor-themes",
    "description": "Gruvbox, Catppuccin, Dracula, Tokyo Night, Everforest, Nord, Rosé Pine, Kanagawa, Solarized and One, light and dark, for the Statamic 6 control panel.",
    "keywords": [
        "statamic",
        "statamic-addon",
        "theme",
        "control-panel",
        "dark-mode",
        "gruvbox",
        "catppuccin",
        "dracula",
        "tokyo-night",
        "everforest",
        "nord",
        "rose-pine",
        "kanagawa",
        "solarized",
        "one-dark"
    ],
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "Jotham Lim",
            "email": "jotham@cothink.ing"
        }
    ],
    "support": {
        "issues": "https://github.com/Jotham-LEC/statamic-editor-themes/issues",
        "source": "https://github.com/Jotham-LEC/statamic-editor-themes"
    },
    "autoload": {
        "psr-4": {
            "JothamLec\\EditorThemes\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JothamLec\\EditorThemes\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.30"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "statamic": {
            "name": "Editor Themes",
            "description": "Popular editor colour schemes, light and dark, for the control panel"
        },
        "laravel": {
            "providers": [
                "JothamLec\\EditorThemes\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
